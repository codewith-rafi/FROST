# Normalise line endings; keep shell scripts LF so they run on Linux
# even when the repository is checked out on Windows.
* text=auto
*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# Binary artifacts
*.png  binary
*.jpg  binary
*.npz  binary
*.pt   binary
*.pkl  binary
*.patch -text
